# Environment Configuration for Group One Trading RAG Enterprise
# Copy this to .env and fill in actual values

# ============================================================================
# APPLICATION
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-change-in-production
API_VERSION=4.0.0

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=group1_rag
DB_USER=postgres
DB_PASSWORD=changeme-in-production
DATABASE_URL=postgresql://postgres:changeme-in-production@postgres:5432/group1_rag

# Database connection pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_TIMEOUT=30

# ============================================================================
# CACHE (Redis)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ============================================================================
# API SERVER
# ============================================================================
PORT=8000
WORKERS=4
HOST=0.0.0.0

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE=3600
REFRESH_TOKEN_EXPIRE=604800

# Rate Limiting
RATE_LIMIT_PER_USER=100  # requests/second
RATE_LIMIT_GLOBAL=1000   # requests/second

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
JAEGER_HOST=jaeger
JAEGER_PORT=6831
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Prometheus
PROMETHEUS_PUSHGATEWAY_URL=http://prometheus:9091

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=group1-rag-backups
S3_BACKUP_PREFIX=backups/rag
BACKUP_RETENTION_DAYS=30

# ============================================================================
# ALERTING
# ============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PAGERDUTY_SERVICE_KEY=your-pagerduty-key

# Email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your-smtp-password

# ============================================================================
# SECURITY
# ============================================================================
CORS_ORIGINS=http://localhost:3000,https://example.com
ALLOWED_HOSTS=api.example.com,localhost

# SSL/TLS (for HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================================================
# GRAFANA
# ============================================================================
GRAFANA_PASSWORD=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SECURITY_ALLOW_EMBED_INIT_STATE_IN_VIEW=true

# ============================================================================
# WORKER CONFIGURATION
# ============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
WORKER_TYPE=background
WORKER_CONCURRENCY=4

# ============================================================================
# INSTANCE IDENTIFICATION
# ============================================================================
INSTANCE_NAME=api-instance-1
WORKER_ID=api-1
HOSTNAME=localhost

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_CACHING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_METRICS=true
ENABLE_TRACING=true

# ============================================================================
# DEVELOPMENT (set to false in production)
# ============================================================================
DEBUG=false
TESTING=false

# ============================================================================
# OPTIONAL: External Services
# ============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
